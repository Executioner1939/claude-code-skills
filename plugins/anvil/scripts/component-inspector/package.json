{
  "name": "@anvil/inspector",
  "version": "0.1.0",
  "private": true,
  "description": "Structural inspector for atomic-design component libraries. Builds per-component cards (props, stories, variants, consumers, tokens) and a full design-system inventory using the TypeScript Compiler API + ast-grep.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "anvil-inspect": "./bin/anvil-inspect.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "inspect": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/**/*.test.ts"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.39.5",
    "commander": "^14.0.1",
    "fast-glob": "^3.3.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.20.6"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
