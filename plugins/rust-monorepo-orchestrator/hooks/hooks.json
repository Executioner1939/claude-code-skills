{
  "description": "Hooks for rust-monorepo-orchestrator. SessionStart injects the captured target standard (.refactor/standard.md) so every session and subagent starts with it. PostToolUse refreshes the inbox registry whenever a ticket file changes. SubagentStop appends to the per-agent activity log for cross-session continuity.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/inject-standard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/refresh-on-inbox-change.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p .claude/agent-memory/_subagents && date -u +%Y-%m-%dT%H:%M:%SZ' subagent stop' >> .claude/agent-memory/_subagents/activity.log",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
