{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Executioner1939/claude-code-skills/plugins/meta-skill-improver/templates/failure-mode.schema.json",
  "title": "Failure-modes JSON",
  "description": "Output of the transcript-miner agent. The clustered, evidence-weighted failure modes that drive the rest of the meta-skill-improver pipeline.",
  "type": "object",
  "required": ["topic", "target_skill", "generated_at", "repos_scanned", "failure_modes"],
  "properties": {
    "topic": {
      "type": "string",
      "description": "Verbatim topic the user passed to /improve-skill."
    },
    "target_skill": {
      "type": ["string", "null"],
      "description": "<plugin>:<skill> identifier, or null for a brand-new skill."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repos_scanned": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "transcript_dir", "transcripts_found", "commits_scanned"],
        "properties": {
          "path": { "type": "string" },
          "transcript_dir": { "type": "string" },
          "transcripts_found": { "type": "integer", "minimum": 0 },
          "commits_scanned": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "title", "summary",
          "frequency", "severity", "recency", "weight",
          "incidents", "candidate_post_conditions", "candidate_skill_rule"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Kebab-case slug. Used as snapshots/<id>/, prompts/<id>.jsonl, postconds/<id>.py."
          },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "frequency": { "type": "number", "minimum": 0, "maximum": 1 },
          "severity": { "type": "number", "minimum": 0, "maximum": 1 },
          "recency": { "type": "number", "minimum": 0, "maximum": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "incidents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "repo", "ref", "when", "excerpt"],
              "properties": {
                "source": { "enum": ["transcript", "commit"] },
                "repo": { "type": "string" },
                "ref": { "type": "string" },
                "turn": { "type": "integer" },
                "when": { "type": "string", "format": "date-time" },
                "excerpt": { "type": "string" },
                "context": { "type": "string" }
              }
            }
          },
          "candidate_post_conditions": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "candidate_skill_rule": { "type": "string" },
          "retired": {
            "type": "boolean",
            "description": "When true, the harness skips this mode. Used when the underlying tooling has changed and the failure no longer applies."
          }
        }
      }
    },
    "git_only_findings": {
      "type": "array",
      "description": "Optional list of clusters with commit evidence but no transcript evidence. Surface separately so the orchestrator can decide whether to run a dedicated mining pass.",
      "items": { "type": "object" }
    }
  }
}
