{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Executioner1939/claude-code-skills/blob/main/skills/design-storybook-atomic/skills/audit-atomic/schemas/inventory.schema.json",
  "title": "Design-System Component Inventory",
  "description": "Queryable graph of every UI component in a project, classified by atomic-design tier. Emitted by scan-components.sh and consumed by all audit-* workflows. Components are nodes; composes/consumers are directed edges. Designed to be diffable, jq-queryable, and convertible to Mermaid/GraphViz/Cytoscape with simple transforms.",
  "type": "object",
  "required": ["schemaVersion", "scannedAt", "scope", "components", "edges"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "scannedAt": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "required": ["root", "tiersScanned"],
      "properties": {
        "root": { "type": "string", "description": "Absolute path the scan was rooted at." },
        "tiersScanned": {
          "type": "array",
          "items": { "$ref": "#/$defs/tier" },
          "description": "Tiers this scan walked. Audits typically run per-tier; cross-tier walks set all five."
        },
        "framework": { "type": "string", "enum": ["react", "react-native", "vue", "svelte", "solid", "angular", "unknown"] },
        "stylingSystem": { "type": "string", "enum": ["tailwind", "nativewind", "css-modules", "styled-components", "emotion", "vanilla-css", "linaria", "panda", "mixed", "unknown"] }
      }
    },
    "rubricOverrides": {
      "type": "object",
      "description": "Project-level conventions detected in Phase 0a, surfaced here so every consumer agent grades against the same rules.",
      "properties": {
        "mdxConvention": { "type": "string", "enum": ["per-component", "per-category", "none"] },
        "formContract": { "type": "string", "enum": ["tanstack-form", "react-hook-form", "native-dom", "other"] },
        "tierPlacement": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/tier" },
          "description": "Map of contract name -> tier where it is implemented in this project. Drives the tier-aware contract resolution check."
        },
        "tokenConvention": { "type": "string", "enum": ["css-vars", "ts-objects", "tailwind-theme", "hybrid"] },
        "lintRulesAffectingTiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "affectsTiers"],
            "properties": {
              "rule": { "type": "string" },
              "affectsTiers": { "type": "array", "items": { "$ref": "#/$defs/tier" } },
              "exempted": { "type": "boolean" }
            }
          }
        }
      }
    },
    "baselineIntegrity": {
      "type": "object",
      "description": "Result of Phase 0b probe. Pre-existing breakage is quarantined here and never counted against atom defects.",
      "properties": {
        "typecheck": { "type": "string", "enum": ["pass", "fail", "skipped"] },
        "lint": { "type": "string", "enum": ["pass", "fail", "skipped"] },
        "testStoriesSmoke": { "type": "string", "enum": ["pass", "fail", "skipped"] },
        "preExistingFailures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "enum": ["import-time", "assertion-time", "a11y", "type-error", "lint-error"] },
              "path": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "duplicateClusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "members", "similarity"],
        "properties": {
          "id": { "type": "string" },
          "members": { "type": "array", "items": { "type": "string" } },
          "similarity": { "type": "number", "minimum": 0, "maximum": 1 },
          "proposedCanonical": { "type": "string" }
        }
      }
    },
    "reconciliation": {
      "type": "array",
      "description": "Files and folders that look like UI components but do not match atomic-design conventions. Each entry is something a human must reconcile — rename, move, split, or classify. Generated alongside the component graph in every scan so the audit can surface the cleanup list without re-walking.",
      "items": {
        "type": "object",
        "required": ["kind", "path", "severity", "expected", "actual"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "misnamed-file",
              "misnamed-folder",
              "unfoldered",
              "folder-name-mismatch",
              "tier-mismatch-by-signal",
              "multiple-components-per-file",
              "stray-component",
              "non-pascal-export",
              "co-located-orphan",
              "ambiguous-tier"
            ],
            "description": "What kind of mismatch. misnamed-file: lowercase or kebab-case filename. misnamed-folder: folder not PascalCase. unfoldered: tier-level Foo.tsx without enclosing Foo/ folder. folder-name-mismatch: Foo/Bar.tsx (folder and primary export disagree). tier-mismatch-by-signal: lives under atoms/ but signals say molecule. multiple-components-per-file: >1 PascalCase exported component in one file. stray-component: PascalCase .tsx that looks like a component but lives outside tier folders. non-pascal-export: exports lowercase or camelCase names where PascalCase expected. co-located-orphan: file inside a tier folder that is neither component, stories, test, mdx, nor a known helper. ambiguous-tier: signals contradict folder placement and confidence is low."
          },
          "path": { "type": "string", "description": "Relative path to the offending file or folder." },
          "severity": { "type": "string", "enum": ["block", "warn", "info"] },
          "expected": { "type": "string", "description": "What the path/name should look like." },
          "actual": { "type": "string", "description": "What it currently is." },
          "componentId": { "type": "string", "description": "If this entry maps to a component already in components[], its id." },
          "fix": { "type": "string", "description": "Short, mechanical fix recommendation a code-mod could apply." },
          "evidence": { "type": "array", "items": { "type": "string" }, "description": "Lines or paths that justify the classification." }
        }
      }
    }
  },
  "$defs": {
    "tier": { "type": "string", "enum": ["quark", "atom", "molecule", "organism", "template", "page", "unclassified"] },
    "edgeKind": { "type": "string", "enum": ["composes", "consumes", "extends", "implements-contract"] },
    "edge": {
      "type": "object",
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "type": "string", "description": "Component id (e.g. 'atoms/Button')." },
        "to": { "type": "string" },
        "kind": { "$ref": "#/$defs/edgeKind" }
      }
    },
    "component": {
      "type": "object",
      "required": ["id", "tier", "path"],
      "properties": {
        "id": { "type": "string", "description": "Stable id, e.g. 'atoms/Button'. Used as graph-node key." },
        "tier": { "$ref": "#/$defs/tier" },
        "tierConfidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "path": { "type": "string", "description": "Relative path to the component file." },
        "exports": { "type": "array", "items": { "type": "string" } },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "required": { "type": "boolean" },
              "default": { "type": "string" }
            },
            "required": ["name"]
          }
        },
        "forwardsRef": { "type": "boolean" },
        "ariaProps": { "type": "array", "items": { "type": "string" } },
        "deprecated": { "type": "boolean" },
        "lastModified": { "type": "string", "format": "date" },
        "hardcodedLiterals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["line", "kind", "value"],
            "properties": {
              "line": { "type": "integer" },
              "kind": { "type": "string", "enum": ["color-hex", "color-rgb", "color-hsl", "spacing-px", "spacing-rem", "font-size", "font-weight", "duration", "shadow", "z-index", "radius"] },
              "value": { "type": "string" }
            }
          }
        },
        "stories": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "format": { "type": "string", "enum": ["csf-factories", "csf3", "csf2", "storiesOf", "none"] },
            "count": { "type": "integer" },
            "names": { "type": "array", "items": { "type": "string" } },
            "hasAllVariants": { "type": "boolean" },
            "hasPlay": { "type": "boolean" },
            "hasFocus": { "type": "boolean" },
            "hasRTL": { "type": "boolean" },
            "hasAxeOverrides": { "type": "boolean" }
          }
        },
        "mdx": {
          "type": "object",
          "properties": {
            "present": { "type": "boolean" },
            "path": { "type": "string" },
            "mode": { "type": "string", "enum": ["per-component", "per-category", "none"] },
            "sectionsPresent": { "type": "array", "items": { "type": "string" } },
            "sectionsMissing": { "type": "array", "items": { "type": "string" } }
          }
        },
        "consumers": { "type": "array", "items": { "type": "string" }, "description": "Component ids that import this one. Mirrors edges[from=*].to=this." },
        "composes": { "type": "array", "items": { "type": "string" }, "description": "Component ids this one imports. Mirrors edges[from=this].to=*." },
        "contractRef": { "type": "string", "description": "If this component implements a known contract (e.g. ds-core/component-contracts/button), the path to the contract file." },
        "contractName": { "type": "string" },
        "lintViolations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "line"],
            "properties": {
              "rule": { "type": "string" },
              "line": { "type": "integer" },
              "message": { "type": "string" }
            }
          }
        },
        "tierViolations": {
          "type": "array",
          "items": { "type": "string", "description": "e.g. 'atom-imports-molecule:atoms/Foo->molecules/Bar'." }
        },
        "tokenCompliance": {
          "type": "object",
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "literalsCount": { "type": "integer" }
          }
        }
      }
    }
  }
}
